generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  BILLING_CLERK
  INVENTORY_MANAGER
  SERVICE_STAFF
}

enum ServiceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  // Any other interval — the number of months is in Warranty.frequencyMonths.
  CUSTOM
}

// PHYSICAL = a stocked good (tracked quantity, sellable only while in stock).
// SERVICE = a billable line item with no physical stock (labor, visit fees,
// installation charges…) — always sellable, stock fields are inert.
enum ProductType {
  PHYSICAL
  SERVICE
}

enum WarrantyStatus {
  PENDING_APPROVAL
  ACTIVE
  CANCELLED
}

enum ServiceJobStatus {
  // Asked for by a technician; waits for an admin to approve or reject.
  REQUESTED
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SERVICE_JOB_COMPLETED
  NEW_LEAD
  SERVICE_REQUESTED  // technician asked for a visit → admins
  JOB_ASSIGNED       // a visit was assigned to a technician → that technician
  REQUEST_DECIDED    // admin approved/rejected a technician's request → requester
}

enum NotificationStatus {
  UNREAD
  ACKNOWLEDGED
  ACTION_NOTED
  RESOLVED
}

enum QuotationStatus {
  OPEN
  CONVERTED
  EXPIRED
  CANCELLED
}

enum LeadSource {
  WHATSAPP
  FORM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

enum AttributeFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTISELECT
}

enum StockStatus {
  IN_STOCK
  SOLD
  RESERVED
  DEFECTIVE_RMA
}

// SALES = counter sale / checkout; SERVICE = technician service bill.
enum BillType {
  SALES
  SERVICE
}

// Which running number a bill takes. GST sales bills get their own series
// (the only bills filed with the auditor); non-GST sales and service bills
// each have theirs.
enum BillSeries {
  GST_SALES
  SALES
  SERVICE
}

// The tick-box row on the technician's paper service bill.
enum ServiceCategory {
  WARRANTY
  OUT_OF_WARRANTY
  OTHER_SERVICE
  IRF
  AMC
}

enum InvoiceStatus {
  DRAFT
  PAID
  PARTIALLY_PAID
  CANCELLED
  RETURNED
}

enum PaymentMode {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  BANK_TRANSFER
  EMI
}

enum AuditAction {
  STOCK_IN
  STOCK_OUT
  STOCK_ADJUST
  PRICE_CHANGE
  INVOICE_CREATE
  INVOICE_CANCEL
  RETURN_PROCESS
  PAYMENT_RECEIVED
  USER_CREATE
  USER_UPDATE
  DISCOUNT_OVERRIDE
}

// ─── Users & Store ────────────────────────────────────────────────────────────

model Store {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  gstNumber   String?  @map("gst_number")
  logoUrl     String?  @map("logo_url")
  staticQrUrl String?  @map("static_qr_url")
  // Default lookahead window (in days) for the "Next Service" screen — how
  // far ahead an upcoming service visit shows up before its due date.
  nextServiceLookaheadDays Int @default(30) @map("next_service_lookahead_days")
  // Customer-care terms printed on the warranty card (the client's card has
  // a Tamil block here). Plain text, one line per row.
  warrantyCardTerms String? @map("warranty_card_terms")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                User[]
  inventory            SerialInventory[]
  invoices             Invoice[]
  products             Product[]
  skus                 SKU[]
  auditLogs            AuditLog[]
  attributeDefinitions AttributeDefinition[]
  warranties           Warranty[]
  serviceJobs          ServiceJob[]
  serviceJobParts      ServiceJobPart[]
  quotations           Quotation[]
  notifications        Notification[]
  websiteProducts      WebsiteProduct[]
  websiteCategories    WebsiteCategory[]
  leads                Lead[]

  @@map("stores")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  storeId      String   @map("store_id")
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  invoices      Invoice[] @relation("InvoiceCreatedBy")
  technicianInvoices Invoice[] @relation("InvoiceTechnician")
  auditLogs     AuditLog[]
  approvedWarranties  Warranty[]
  assignedServiceJobs ServiceJob[] @relation("ServiceJobAssignee")
  remindedServiceJobs ServiceJob[] @relation("ServiceJobReminder")
  requestedServiceJobs ServiceJob[] @relation("ServiceJobRequester")
  notifications       Notification[] @relation("NotificationRecipient")
  quotations          Quotation[]

  @@index([email])
  @@index([storeId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("refresh_tokens")
}

// ─── Products & Inventory ─────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model AttributeDefinition {
  id         String             @id @default(cuid())
  storeId    String             @map("store_id")
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entityType String             @map("entity_type") // "PRODUCT" | "CUSTOMER"
  key        String             // machine key, e.g. "compatible_models"
  label      String             // display label, e.g. "Compatible Models"
  fieldType  AttributeFieldType @map("field_type")
  options    Json?              // string[] for SELECT/MULTISELECT
  required   Boolean            @default(false)
  sortOrder  Int                @default(0) @map("sort_order")
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([storeId, entityType, key])
  @@index([storeId, entityType])
  @@map("attribute_definitions")
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?
  gstin   String?

  purchaseOrders PurchaseOrder[]
  inventory      SerialInventory[]

  @@map("suppliers")
}

model Product {
  id               String      @id @default(cuid())
  name             String
  brand            String?
  partNumber       String?     @map("part_number")   // manufacturer part/SKU number
  categoryId       String      @map("category_id")
  category         Category    @relation(fields: [categoryId], references: [id])
  storeId          String      @map("store_id")
  store            Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  description      String?
  hsnCode          String?     @map("hsn_code")
  requiresService  Boolean     @default(false) @map("requires_service")
  type             ProductType @default(PHYSICAL)
  isActive         Boolean     @default(true) @map("is_active")
  customFields     Json?       @map("custom_fields")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  skus       SKU[]
  warranties Warranty[]

  @@index([storeId])
  @@index([partNumber])
  @@map("products")
}

model SKU {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId           String   @map("store_id")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantName       String   @map("variant_name")   // e.g. "Standard", "BS6", "Chrome"
  unit              String   @default("PCS")         // PCS, SET, LITER, PAIR, METER
  isSerialized      Boolean  @default(false) @map("is_serialized") // false = bulk qty tracking
  stockQty          Decimal  @default(0) @db.Decimal(10, 3) @map("stock_qty") // for non-serialized parts — Decimal so weight/volume/length units (KG, LITER, METER) can hold fractional stock
  costPrice         Decimal  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(10, 2)
  taxRate           Decimal  @default(18) @map("tax_rate") @db.Decimal(5, 2)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  barcode           String?  @unique
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  serialInventory    SerialInventory[]
  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  quotationItems     QuotationItem[]
  serviceJobParts    ServiceJobPart[]

  @@index([productId])
  @@index([storeId])
  @@index([barcode])
  @@map("skus")
}

model SerialInventory {
  id            String      @id @default(cuid())
  skuId         String      @map("sku_id")
  sku           SKU         @relation(fields: [skuId], references: [id], onDelete: Cascade)
  storeId       String      @map("store_id")
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId    String?     @map("supplier_id")
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  serialNumber  String?     @unique @map("serial_number") // for serialized high-value parts
  batchNumber   String?     @map("batch_number")          // batch/lot tracking
  status        StockStatus @default(IN_STOCK)
  purchasedAt   DateTime?   @map("purchased_at")
  soldAt        DateTime?   @map("sold_at")
  invoiceItemId String?     @map("invoice_item_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])

  @@index([serialNumber])
  @@index([skuId])
  @@index([storeId])
  @@map("serial_inventory")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id         String            @id @default(cuid())
  supplierId String            @map("supplier_id")
  supplier   Supplier          @relation(fields: [supplierId], references: [id])
  status     String            @default("DRAFT")
  notes      String?
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  skuId           String        @map("sku_id")
  sku             SKU           @relation(fields: [skuId], references: [id])
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)

  @@map("purchase_order_items")
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  city      String?
  landmark  String?
  gstin     String?
  // "Customer ID" on the paper warranty card / service record (e.g. 301).
  cardNo    String?  @unique @map("card_no")
  isActive  Boolean  @default(true) @map("is_active")
  customFields Json? @map("custom_fields")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices   Invoice[]
  warranties Warranty[]
  quotations Quotation[]

  @@index([phone])
  @@map("customers")
}

// ─── Invoices & Payments ──────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique @map("invoice_number")
  storeId        String        @map("store_id")
  store          Store         @relation(fields: [storeId], references: [id])
  customerId     String?       @map("customer_id")
  customer       Customer?     @relation(fields: [customerId], references: [id])
  createdById    String        @map("created_by_id")
  createdBy      User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  status         InvoiceStatus @default(DRAFT)
  // Printed bill number — short running number per series (GST bills reset
  // each financial year, the others run continuously), or typed in by hand
  // when entering an existing paper bill. invoiceNumber stays the internal id.
  billType        BillType         @default(SALES) @map("bill_type")
  billSeries      BillSeries?      @map("bill_series")
  billFy          String?          @map("bill_fy")
  billNo          String?          @map("bill_no")
  serviceCategory ServiceCategory? @map("service_category")
  technicianId    String?          @map("technician_id")
  technician      User?            @relation("InvoiceTechnician", fields: [technicianId], references: [id])
  tdsRaw          String?          @map("tds_raw")
  tdsTreated      String?          @map("tds_treated")
  subtotal       Decimal       @db.Decimal(10, 2)
  discountType   String?       @map("discount_type")
  discountValue  Decimal       @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  gstApplied     Boolean       @default(true) @map("gst_applied")
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  notes          String?
  managerOverride Boolean      @default(false) @map("manager_override")
  overriddenById  String?      @map("overridden_by_id")
  qrPayload      String?       @map("qr_payload")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  items          InvoiceItem[]
  payments       Payment[]
  quotationOrigin Quotation?
  serviceJobOrigin ServiceJob?

  @@unique([storeId, billSeries, billFy, billNo])
  @@index([invoiceNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([createdAt])
  @@index([storeId, billType])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String  @map("invoice_id")
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  skuId        String  @map("sku_id")
  sku          SKU     @relation(fields: [skuId], references: [id])
  quantity     Decimal @db.Decimal(10, 3)                          // Decimal so weight/volume/length units can be sold in fractional amounts
  returnedQty  Decimal @default(0) @db.Decimal(10, 3) @map("returned_qty")
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal @map("tax_amount") @db.Decimal(10, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(10, 2)
  hsnCode      String? @map("hsn_code")
  // Free-typed line text (service bills: "IRF media changed", "Service
  // charges") — printed instead of the product name when set.
  description  String?
  // Item cost at the moment of sale, for profit reports. Null on bills made
  // before this was recorded — those fall back to the item's current cost.
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)

  serialUnits SerialInventory[]
  warranty    Warranty?

  @@map("invoice_items")
}

model Payment {
  id        String      @id @default(cuid())
  invoiceId String      @map("invoice_id")
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mode      PaymentMode
  amount    Decimal     @db.Decimal(10, 2)
  reference String?
  paidAt    DateTime    @default(now()) @map("paid_at")

  @@index([invoiceId])
  @@map("payments")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  storeId    String      @map("store_id")
  store      Store       @relation(fields: [storeId], references: [id])
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([storeId])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Service / Warranty ───────────────────────────────────────────────────────

model Warranty {
  id                   String            @id @default(cuid())
  storeId              String            @map("store_id")
  store                Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId           String            @map("customer_id")
  customer             Customer          @relation(fields: [customerId], references: [id])
  // Null for a standalone AMC registered directly (no sale in this system —
  // e.g. a pre-existing customer onboarded via bulk import, or a unit sold
  // elsewhere). Set when the warranty originated from a checkout/quotation
  // sale of a requiresService product.
  invoiceItemId        String?           @unique @map("invoice_item_id")
  invoiceItem          InvoiceItem?      @relation(fields: [invoiceItemId], references: [id])
  productId            String            @map("product_id")
  product              Product           @relation(fields: [productId], references: [id])
  status               WarrantyStatus    @default(PENDING_APPROVAL)
  warrantyPeriodMonths Int?              @map("warranty_period_months")
  serviceFrequency     ServiceFrequency? @map("service_frequency")
  // Months between visits when serviceFrequency is CUSTOM.
  frequencyMonths      Int?              @map("frequency_months")
  notes                String?
  approvedById         String?           @map("approved_by_id")
  approvedBy           User?             @relation(fields: [approvedById], references: [id])
  approvedAt           DateTime?         @map("approved_at")
  startDate            DateTime          @map("start_date") // = sale date
  nextServiceDueAt     DateTime?         @map("next_service_due_at")
  // Warranty card / service record details (client's paper card layout).
  cardDate             DateTime?         @map("card_date")
  tds                  String?
  hardness             String?
  iron                 String?
  otherImpurities      String?           @map("other_impurities")
  brand                String?
  model                String?
  pump                 String?
  membrane             String?
  power                String?
  vessel               String?
  valve                String?
  media                String?
  soldBy               String?           @map("sold_by")
  installedBy          String?           @map("installed_by")
  amcFrom              DateTime?         @map("amc_from")
  amcTo                DateTime?         @map("amc_to")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  serviceJobs ServiceJob[]

  @@index([storeId, status])
  @@index([customerId])
  @@map("warranties")
}

model ServiceJob {
  id                   String           @id @default(cuid())
  warrantyId           String           @map("warranty_id")
  warranty             Warranty         @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  storeId              String           @map("store_id") // denormalized for indexing
  store                Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dueDate              DateTime         @map("due_date")
  assignedToId         String?          @map("assigned_to_id")
  assignedTo           User?            @relation("ServiceJobAssignee", fields: [assignedToId], references: [id])
  assignedAt           DateTime?        @map("assigned_at")
  status               ServiceJobStatus @default(SCHEDULED)
  visitDate            DateTime?        @map("visit_date")
  customerFeedback     String?          @map("customer_feedback")
  staffExpenseAmount   Decimal?         @db.Decimal(10, 2) @map("staff_expense_amount")
  staffExpenseNotes    String?          @map("staff_expense_notes")
  customerChargeAmount Decimal?         @db.Decimal(10, 2) @map("customer_charge_amount")
  customerChargeNotes  String?          @map("customer_charge_notes")
  // Once the recorded customerChargeAmount is actually billed, this points at
  // the real GST invoice/payment record — before that, the charge amount is
  // just a field the technician noted in the field.
  invoiceId            String?          @unique @map("invoice_id")
  invoice              Invoice?         @relation(fields: [invoiceId], references: [id])
  closedAt             DateTime?        @map("closed_at")
  // Next Service screen: customer was called/messaged about this visit.
  remindedAt           DateTime?        @map("reminded_at")
  remindedById         String?          @map("reminded_by_id")
  remindedBy           User?            @relation("ServiceJobReminder", fields: [remindedById], references: [id])
  // Extra visit outside the regular AMC cycle (e.g. a technician's request):
  // closing it does not schedule the next regular visit.
  isExtra              Boolean          @default(false) @map("is_extra")
  requestedById        String?          @map("requested_by_id")
  requestedBy          User?            @relation("ServiceJobRequester", fields: [requestedById], references: [id])
  requestNote          String?          @map("request_note")
  reviewNote           String?          @map("review_note")
  serviceCategory      ServiceCategory? @map("service_category")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  parts         ServiceJobPart[]
  notifications Notification[]

  @@index([storeId, status, dueDate])
  @@index([assignedToId, status])
  @@map("service_jobs")
}

// A spare part/consumable (filter, membrane, o-ring…) a technician used
// during a visit — decrements real inventory stock the moment it's logged,
// and its price/tax are snapshotted here so a later invoice always reflects
// what was actually charged, even if the SKU's price changes afterward.
model ServiceJobPart {
  id           String     @id @default(cuid())
  serviceJobId String     @map("service_job_id")
  serviceJob   ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  storeId      String     @map("store_id")
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  skuId        String     @map("sku_id")
  sku          SKU        @relation(fields: [skuId], references: [id])
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 2) @map("unit_price")
  taxRate      Decimal    @db.Decimal(5, 2) @map("tax_rate")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([serviceJobId])
  @@map("service_job_parts")
}

// In-app alert for something an admin should look at — currently only
// raised when a technician closes a service job. Kept simple on purpose:
// an admin either acknowledges it (nothing more to do) or leaves an
// action note on it (a reminder for themself, not a reassignment — the
// job itself is already reassignable from Service Jobs) until resolved.
model Notification {
  id           String              @id @default(cuid())
  storeId      String              @map("store_id")
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type         NotificationType
  serviceJobId String?             @map("service_job_id")
  serviceJob   ServiceJob?         @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)
  leadId       String?             @map("lead_id")
  lead         Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title        String
  body         String
  status       NotificationStatus  @default(UNREAD)
  actionNote   String?             @map("action_note")
  createdAt    DateTime            @default(now()) @map("created_at")
  resolvedAt   DateTime?           @map("resolved_at")
  resolvedById String?             @map("resolved_by_id")
  // Null = for the store's admins; set = for that one user (e.g. a technician).
  recipientUserId String?          @map("recipient_user_id")
  recipient       User?            @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([recipientUserId, status])
  @@map("notifications")
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique @map("quotation_number")
  storeId            String          @map("store_id")
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId         String?         @map("customer_id")
  customer           Customer?       @relation(fields: [customerId], references: [id])
  createdById        String          @map("created_by_id")
  createdBy          User            @relation(fields: [createdById], references: [id])
  status             QuotationStatus @default(OPEN)
  subtotal           Decimal         @db.Decimal(10, 2)
  discountType       String?         @map("discount_type")
  discountValue      Decimal         @default(0) @db.Decimal(10, 2) @map("discount_value")
  discountAmount     Decimal         @default(0) @db.Decimal(10, 2) @map("discount_amount")
  gstApplied         Boolean         @default(true) @map("gst_applied")
  taxAmount          Decimal         @db.Decimal(10, 2) @map("tax_amount")
  totalAmount        Decimal         @db.Decimal(10, 2) @map("total_amount")
  notes              String?
  validUntil         DateTime?       @map("valid_until")
  convertedInvoiceId String?         @unique @map("converted_invoice_id")
  convertedInvoice   Invoice?        @relation(fields: [convertedInvoiceId], references: [id])
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  items QuotationItem[]

  @@index([storeId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  skuId       String    @map("sku_id")
  sku         SKU       @relation(fields: [skuId], references: [id])
  quantity    Decimal   @db.Decimal(10, 3)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(10, 2)
  taxRate     Decimal   @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal   @map("tax_amount") @db.Decimal(10, 2)
  lineTotal   Decimal   @map("line_total") @db.Decimal(10, 2)

  @@map("quotation_items")
}

// ─── Public Website (catalog + leads) ────────────────────────────────────────
// Powers the marketing/ecommerce site's product catalog and cart-to-lead flow.
// Reached two ways: an unauthenticated public API (resolved via
// PlatformAccount.siteKey in the master DB, not a JWT) for the storefront
// itself, and the normal authenticated tenant API for admin management here.

// Two-level storefront catalog tree, like the supplier app the client showed:
// "Domestic RO System" → "12 LPH", "Domestic Spares" → "Membrane"…
model WebsiteCategory {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?  @map("parent_id")
  parent    WebsiteCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WebsiteCategory[] @relation("CategoryTree")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products    WebsiteProduct[] @relation("ProductCategory")
  subProducts WebsiteProduct[] @relation("ProductSubCategory")

  @@index([storeId, parentId])
  @@map("website_categories")
}

model WebsiteProduct {
  id               String   @id @default(cuid())
  storeId          String   @map("store_id")
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Display name of the top-level category — kept in sync from categoryId
  // when one is picked, so older storefront code reading it keeps working.
  category         String   // e.g. "Household RO/UV/Softener", "Commercial RO Plants"
  categoryId       String?  @map("category_id")
  categoryRef      WebsiteCategory? @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId    String?  @map("sub_category_id")
  subCategory      WebsiteCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  brand            String?
  name             String
  shortDescription String?  @map("short_description")
  description      String?
  mrpPrice         Decimal? @map("mrp_price") @db.Decimal(10, 2)
  sellingPrice     Decimal? @map("selling_price") @db.Decimal(10, 2)
  capacityLph      Int?     @map("capacity_lph") // commercial plants only
  images           Json     @default("[]") // string[] of /images paths
  specSheetUrl     String?  @map("spec_sheet_url")
  isFeatured       Boolean  @default(false) @map("is_featured")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([storeId, isActive])
  @@map("website_products")
}

model Lead {
  id           String     @id @default(cuid())
  storeId      String     @map("store_id")
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName String     @map("customer_name")
  phone        String
  email        String?
  address      String?
  message      String?
  items        Json       @default("[]") // [{ productId, name, qty }]
  source       LeadSource
  status       LeadStatus @default(NEW)
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  notifications Notification[]

  @@index([storeId, status])
  @@map("leads")
}

// Running counters for printed document numbers (bill series, warranty card
// numbers). Incremented with a single UPDATE … RETURNING so two bills saved
// at the same moment can't take the same number. fy is "2026-27" for series
// that reset each financial year, "ALL" for continuous ones.
model DocSequence {
  storeId String @map("store_id")
  key     String // BillSeries value, or "CARD"
  fy      String
  next    Int    @default(1)

  @@id([storeId, key, fy])
  @@map("doc_sequences")
}
