// Master/platform database — holds only account registry + password-reset queue.
// Every PlatformAccount points at its own separate tenant database (see backend/prisma/schema.prisma),
// provisioned dynamically at signup. This schema is intentionally tiny and never holds business data.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ResetRequestStatus {
  PENDING
  RESOLVED
}

model PlatformAccount {
  id           String        @id @default(cuid())
  businessName String        @map("business_name")
  ownerName    String        @map("owner_name")
  email        String        @unique
  phone        String        @unique
  tenantDbName String        @unique @map("tenant_db_name")
  tenantDbUrl  String        @map("tenant_db_url")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  resetRequests PasswordResetRequest[]

  @@map("platform_accounts")
}

// Single-row table (id is always "singleton") for platform-wide settings that used
// to be env-var-only — SMTP + the address that gets notified of reset requests.
// Env vars remain a fallback for whichever of these fields aren't set here yet.
model PlatformSettings {
  id               String   @id @default("singleton")
  smtpHost         String?  @map("smtp_host")
  smtpPort         Int?     @map("smtp_port")
  smtpUser         String?  @map("smtp_user")
  smtpPass         String?  @map("smtp_pass")
  smtpFrom         String?  @map("smtp_from")
  adminNotifyEmail String?  @map("admin_notify_email")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  resolvedRequests PasswordResetRequest[]

  @@map("platform_admins")
}

model PasswordResetRequest {
  id             String              @id @default(cuid())
  accountId      String              @map("account_id")
  account        PlatformAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedEmail String              @map("requested_email")
  status         ResetRequestStatus  @default(PENDING)
  createdAt      DateTime            @default(now()) @map("created_at")
  resolvedAt     DateTime?           @map("resolved_at")
  resolvedById   String?             @map("resolved_by_id")
  resolvedBy     PlatformAdmin?      @relation(fields: [resolvedById], references: [id])

  @@index([accountId])
  @@index([status])
  @@map("password_reset_requests")
}
