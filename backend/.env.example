# Legacy single-tenant DB (kept as the template schema; no longer read directly once
# multi-tenant provisioning is live — each tenant gets its own DATABASE_URL at runtime).
DATABASE_URL="postgresql://user:password@localhost:5432/mobilebilling?schema=public"

# Master/platform DB — account registry + password-reset queue. One instance, shared.
MASTER_DATABASE_URL="postgresql://user:password@localhost:5432/mobilebilling_master?schema=public"

# Superuser connection used ONLY to CREATE DATABASE for new tenants at signup.
# Must point at a maintenance DB (usually "postgres") with a role that has CREATEDB privilege.
PG_ADMIN_URL="postgresql://postgres:password@localhost:5432/postgres"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
PLATFORM_ADMIN_JWT_SECRET="change-me-platform-admin-secret-min-32-chars"
FRONTEND_URL="http://localhost:3000"
STORE_UPI_VPA="merchant@upi"
PORT=4000
NODE_ENV=development

# SMTP for admin notifications + password-reset delivery. Until set, mailer logs instead of sending.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aadhirai Billing <no-reply@aadhirai.example>"
ADMIN_NOTIFY_EMAIL="admin@aadhirai.example"
